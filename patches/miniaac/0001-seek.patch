+int miniaac_seekable(const miniaac *d) { return d && d->magic==MAGIC && !d->adts; }
+miniaac_status miniaac_seek(miniaac *d,uint64_t frame,int16_t *pcm,size_t capacity,size_t *count,
+                           miniaac_seek_hook hook,void *user) {
+    uint64_t raw,skip=0,base=0,span,offset;
+    uint32_t packet,first,next,per=0,map,chunk=0,inside=0,i,bytes;
+    uint8_t *p; miniaac_status rc;
+    if(!count) return MINIAAC_ARGUMENT;
+    *count=0;
+    if(!d || d->magic!=MAGIC || !pcm) return MINIAAC_ARGUMENT;
+    if(capacity<MINIAAC_PCM_SAMPLES) return MINIAAC_OUTPUT_TOO_SMALL;
+    if(d->adts) return MINIAAC_UNSUPPORTED;
+    if(!d->info.total_frames) return MINIAAC_EOF;
+    if(frame>=d->info.total_frames) frame=d->info.total_frames-1;
+    raw=d->trim_start+frame;
+    if(d->chunks==UINT32_MAX) return MINIAAC_FORMAT;
+    packet=(uint32_t)(raw/1024);
+    /* AAC-LC overlap/history warms up in existing PCM storage; tested against
+       sequential reference windows, including short/long block transitions. */
+    packet=packet>8 ? packet-8 : 0;
+    for(map=0;map<d->mappings.count;map++) {
+        if(hook && hook(user)) return MINIAAC_CANCELLED;
+        TRY(entry(d,&d->mappings,map,&p)); first=be32(p); per=be32(p+4);
+        next=d->chunks+1;
+        if(map+1<d->mappings.count) { TRY(entry(d,&d->mappings,map+1,&p)); next=be32(p); }
+        if(!per || next<=first) return MINIAAC_FORMAT;
+        span=(uint64_t)(next-first)*per;
+        if(packet<base+span) {
+            skip=packet-base;chunk=first+(uint32_t)(skip/per);inside=(uint32_t)(skip%per);break;
+        }
+        base+=span;
+    }
+    if(!chunk || chunk>d->chunks || map>=d->mappings.count) return MINIAAC_FORMAT;
+    TRY(entry(d,&d->offsets,chunk-1,&p));offset=d->offsets.width==8 ? be64(p) : be32(p);
+    if(offset<d->mdat_start || offset>d->mdat_end) return MINIAAC_FORMAT;
+    if(d->fixed_size) {
+        skip=(uint64_t)inside*d->fixed_size;
+        if(skip>d->mdat_end-offset) return MINIAAC_FORMAT;
+        offset+=skip;
+    } else for(i=0;i<inside;i++) {
+        if(!(i&63) && hook && hook(user)) return MINIAAC_CANCELLED;
+        TRY(entry(d,&d->sizes,packet-inside+i,&p));bytes=be32(p);
+        if(!bytes || bytes>MINIAAC_INPUT_BYTES || bytes>d->mdat_end-offset) return MINIAAC_FORMAT;
+        offset+=bytes;
+    }
+    if(hook && hook(user)) return MINIAAC_CANCELLED;
+    if(AACFlushCodec(d->codec)) return MINIAAC_CODEC;
+    d->failed=MINIAAC_OK;d->sample=packet;d->chunk=chunk;d->in_chunk=inside;
+    d->chunk_samples=per;d->stsc_index=map+1;d->next_chunk=map+1<d->mappings.count ? next : 0;
+    d->chunk_position=offset;d->decoded_frames=(uint64_t)packet*1024;d->position=raw;
+    rc=miniaac_decode_next(d,pcm,capacity,count);
+    if(hook && hook(user)) { *count=0;return MINIAAC_CANCELLED; }
+    return rc;
+}
