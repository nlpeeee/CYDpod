+/* CYDpod: the INTERIM reply to a volume-change registration carries the
+ * receiver's current absolute volume, the only way an AVRCP controller can
+ * read it. Forward it as a change notification with bit 7 set (volumes are
+ * 0..127) so the application can adopt it without treating it as a change
+ * and without re-registering. Other interim replies are still ignored. */
+static void handle_rc_volume_interim_rsp (tAVRC_MSG_VENDOR *vendor_msg)
+{
+    if (!vendor_msg || !vendor_msg->p_vendor_data ||
+        vendor_msg->vendor_len < AVRC_REGISTER_NOTIFICATION_RSP_SIZE_MIN ||
+        vendor_msg->vendor_len < AVRC_RN_VOLUME_CHANGE_EVT_SIZE ||
+        vendor_msg->p_vendor_data[AVRC_RSP_PARAM_VALUE_OFFSET] != ESP_AVRC_RN_VOLUME_CHANGE) {
+        return;
+    }
+    esp_avrc_ct_cb_param_t param;
+    memset(&param, 0, sizeof(esp_avrc_ct_cb_param_t));
+    param.change_ntf.event_id = ESP_AVRC_RN_VOLUME_CHANGE;
+    param.change_ntf.event_parameter.volume = 0x80 | (vendor_msg->p_vendor_data[AVRC_RSP_PARAM_VALUE_OFFSET + 1] & 0x7f);
+    btc_avrc_ct_cb_to_app(ESP_AVRC_CT_CHANGE_NOTIFY_EVT, &param);
+}
